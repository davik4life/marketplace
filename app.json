{
  "expo": {
    "name": "Okirika",
    "slug": "okirika",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.okirika.shop",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.okirika.shop",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#283c30"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#f8f6ef"
        }
      ],
      "expo-font",
      "expo-router"
    ],
    "scheme": "okirika",
    "description": "Thoughtful home and lifestyle goods.",
    "owner": "davik4life1",
    "extra": {
      "eas": {
        "projectId": "e4911d6c-5d87-4b36-a772-eb2d2fcc7c24"
      }
    }
  }
}
